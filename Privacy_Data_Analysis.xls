ss:Type="String">sessionId</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Session identifier</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Single active session per user</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">MongoDB; per login</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Session cookie (withCredentials)</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">HTTP cookie</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Maintain authenticated session</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Browser; per session</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Security headers (Helmet, CSP)</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">HTTP headers</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Harden responses (XSS, clickjacking)</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Per response</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet><Worksheet ss:Name="Device Permissions"><Table><Column ss:Width="160"/><Column ss:Width="90"/><Column ss:Width="240"/><Row ss:Height="30"><Cell ss:StyleID="Header"><Data ss:Type="String">Permission</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Platform</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Why it is requested</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Camera</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Web + App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Selfie for avatar, video calls</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Microphone</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Web + App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Voice &amp; video calls</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Location (fine / coarse)</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Web + App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Location / fraud verification</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Photo library / storage</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Upload profile photo &amp; chat attachments</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Phone state</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Manage call state during sessions</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Bluetooth connect</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Audio routing for calls</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Biometric / fingerprint</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Optional app lock</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Notifications</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Web + App</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Chat / call / appointment alerts</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet><Worksheet ss:Name="Security &amp; Retention"><Table><Column ss:Width="180"/><Column ss:Width="280"/><Column ss:Width="110"/><Row ss:Height="30"><Cell ss:StyleID="Header"><Data ss:Type="String">Topic</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Current implementation</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Status / To define</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Password storage</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Hashed with bcrypt</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">OK</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Transport security</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">HTTPS; Helmet security headers; CSP</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">OK</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Authentication</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">JWT access + refresh rotation; OTP with expiry</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">OK</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Authorization</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Role-based (user / counsellor / admin)</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">OK</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data at rest</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">MongoDB Atlas (encryption per Atlas config)</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Verify encryption-at-rest</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Chat / message deletion</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">deleteChat / clearChat endpoints exist</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">OK (per chat)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Account deletion</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">No full account-deletion flow found</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">TO BUILD (required for privacy law)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data retention period</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Not defined in code</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">TO DEFINE (how long data is kept)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">AI data disclosure</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Chat / photo sent to OpenAI &amp; Google</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">MUST disclose + get consent</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">Consent for sensitive/health data</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Not explicitly captured</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">TO ADD (explicit consent)</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet><Worksheet ss:Name="Privacy Policy Sections"><Table><Column ss:Width="60"/><Column ss:Width="200"/><Column ss:Width="320"/><Row ss:Height="30"><Cell ss:StyleID="Header"><Data ss:Type="String">#</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Section</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">What to include (tailored to this app)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">1</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Introduction &amp; scope</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Who we are (Humaeli), what the app does (mental-health counseling), who this policy covers</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">2</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data we collect</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Reference the &quot;Personal Data Collected&quot; sheet: identity, contact, demographic, health, financial, location, usage</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">3</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Sensitive / health data</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Mental-health chats, medical info, insurance = special-category data; describe extra protection + explicit consent</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">4</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">How we use your data</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Provide counseling, bookings, payments, AI assistance, safety features, notifications</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">5</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Legal basis / consent</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Consent (sensitive data), contract (service delivery), legitimate interest (security/fraud)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">6</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Third parties &amp; sharing</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">List every processor (see &quot;Third-Party Processors&quot; sheet) and what each receives</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">7</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">AI processing disclosure</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Disclose that chat content and uploaded photos are processed by OpenAI and Google AI</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">8</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">International data transfers</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data stored in India (AWS ap-south-1); processors may be outside India (OpenAI/Google/Stream US)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">9</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Payments</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Razorpay processes payment data; we do not store card details</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Cookies &amp; tokens</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Auth tokens &amp; session cookies (see &quot;Cookies &amp; Tokens&quot; sheet)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">11</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Device permissions</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Camera, mic, location, etc. and why (see &quot;Device Permissions&quot; sheet)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">12</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data security</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">bcrypt, HTTPS, JWT, role-based access (see &quot;Security &amp; Retention&quot; sheet)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">13</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data retention</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">State how long each data type is kept and when deleted (TO DEFINE)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">14</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Your rights</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Access, correction, deletion, portability, withdraw consent, complain</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">15</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Account deletion</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">How a user can delete their account and data (flow TO BUILD)</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">16</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Children's / minors' data</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Mental-health app: define minimum age or parental-consent handling</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">17</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Grievance / Contact officer</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">India DPDP Act requires a contact: support@humaeli.com</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">18</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Changes to this policy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">How users are notified of updates; effective date</Data></Cell></Row><Row><Cell ss:StyleID="Wrap"><Data ss:Type="String">19</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Governing law</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">India DPDP Act 2023 (and GDPR if you serve EU users)</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet></Workbook>