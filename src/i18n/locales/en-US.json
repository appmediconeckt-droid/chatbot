  "landing_testimonials_description": "Real stories from people across India who found support and healing through Humaeli.",
  "landing_testimonial_1_quote": "Humaeli helped me through my depression during COVID lockdown in Mumbai. The AI understood my cultural context and connected me with an amazing therapist from AIIMS within 24 hours.",
  "landing_testimonial_1_author": "Rahul Sharma",
  "landing_testimonial_1_role": "Software Engineer, Mumbai",
  "landing_testimonial_1_location": "Maharashtra",
  "landing_testimonial_2_quote": "As a psychiatrist practicing in Bangalore, I appreciate how Humaeli bridges the gap between technology and Indian mental health care. Their referral system is seamless and culturally sensitive.",
  "landing_testimonial_2_author": "Dr. Lakshmi Narayan",
  "landing_testimonial_2_role": "Consultant Psychiatrist, NIMHANS",
  "landing_testimonial_2_location": "Bangalore",
  "landing_testimonial_3_quote": "The mood tracking feature helped me identify patterns related to work pressure in IT industry. Combined with the AI support, it's been a game-changer for managing my anxiety.",
  "landing_testimonial_3_author": "Priya Patel",
  "landing_testimonial_3_role": "Tech Professional, Pune",
  "landing_testimonial_3_location": "Maharashtra",
  "landing_testimonial_4_quote": "My teenage son was struggling with academic pressure. The child psychologist from Delhi and the AI support helped him tremendously. Thank you Humaeli!",
  "landing_testimonial_4_author": "Amit Singh",
  "landing_testimonial_4_role": "Parent, Delhi NCR",
  "landing_testimonial_4_location": "Delhi",
  "landing_testimonial_view": "View testimonial",
  "landing_faq_title": "Frequently Asked Questions",
  "landing_faq_description": "Get answers to common questions about Humaeli services in India.",
  "landing_faq_1_question": "Is Humaeli available in Indian languages?",
  "landing_faq_1_answer": "Yes! We currently support English, Hindi, Tamil, Telugu, Bengali, Marathi, Gujarati, and Kannada. More languages coming soon.",
  "landing_faq_2_question": "Are the doctors qualified in India?",
  "landing_faq_2_answer": "All our doctors are licensed medical professionals in India, with degrees from top institutions like AIIMS, NIMHANS, CMC Vellore, and are registered with the Medical Council of India.",
  "landing_faq_3_question": "Is my data protected under Indian laws?",
  "landing_faq_3_answer": "Absolutely! We comply with Indian data protection laws and IT Act 2000. Your conversations are confidential and encrypted.",
  "landing_faq_4_question": "Do you accept Indian health insurance?",
  "landing_faq_4_answer": "Yes, we work with all major Indian insurance providers including ICICI Lombard, Star Health, New India Assurance, and others. We provide documentation for insurance claims.",
  "landing_faq_5_question": "Can I consult doctors from my city?",
  "landing_faq_5_answer": "Yes, we have doctors available in all major Indian cities including Mumbai, Delhi, Bangalore, Chennai, Kolkata, Pune, Hyderabad, and Ahmedabad.",
  "landing_faq_6_question": "What about emergency support in India?",
  "landing_faq_6_answer": "We have 24/7 crisis support with connections to local helplines. In case of emergency, we can connect you to immediate support in your city.",
